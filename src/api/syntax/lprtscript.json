{
  "scopeName": "source.lprtscript",
  "patterns": [
    {
      "name": "variable.other.constant",
      "match": "mF"
    },
    {
      "name": "comment.line.double-slash",
      "match": "\/\/\\s*.*\n"
    },
    {
      "match": "(@)(\\w+)(:)",
      "captures": {
        "1": {
          "name": "support.function"
        },
        "2": {
          "name": "support.class"
        },
        "3": {
          "name": "punctuation.separator"
        }
      }
    },
    
    {
      "match": "\\s{4}(\\.\\w+)(:)",
      "captures": {
        "1": {
          "name": "support.function"
        },
        "2": {
          "name": "punctuation.separator"
        }
      }
    },
    {
      "match": "(\\w+)(\\s=\\s)([0-9a-zA-Z_]*)((\\()((.*))(\\)))?",
      "captures": {
        "1": {
          "name": "variable.other.constant"
        },
        "2": {
          "name": "punctuation.separator"
        },
        "3": {
          "name": "keyword.control.table"
        },
        "5": {
          "name": "support.other"
        },
        "6": {
          "name": "support.variable"
        },
        "7": {
          "name": "support.variable"
        },
        "8": {
          "name": "support.other"
        }
      }
    },
    {
      "match": "\\s{8}(Grid|Pack|AutoPack|Disable)(\\()(.*)(\\))",
      "captures": {
        "1": {
          "name": "support.function"
        },
        "2": {
          "name": "support.other"
        },
        "3": {
          "name": "support.variable"
        },
        "4": {
          "name": "support.other"
        }
      }
    },
    {
      "name": "meta.tag.custom",
      "begin": "\\s{4}(>)",
      "beginCaptures": {
        "1": { "name": "string.quoted.double" }
      },
      "end": "\\s{4}(<)",
      "endCaptures": {
        "1": {
          "name": "string.quoted.double"
        }
      },
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    }
  ]
}